# 复制本文件为 backend/.env 后按实际情况填写；.env 不入库（见 .gitignore）。
# config.py 按进程工作目录解析 .env，所以必须放在 backend/ 下，不要放进子目录。

# 正式库连接串。测试与迁移演练都不会直接用它：
#   tests/conftest.py 与 scripts/migrate_test_db.py 只会改库名指向隔离库。
DB_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/pet_dog?charset=utf8mb4

# 设备链路模式：
#   ble                低功耗蓝牙（ECB02H2）动态扫描，前端直接点选蓝牙连接并绑定
#   ble://<MAC或地址>   启动时直连指定低功耗蓝牙设备
#   sim                无板软件联调模拟器（支持 BLE 扫描与直连流程演示）
#   COM5               USB-TTL 有线串口调试/回退
#   loop://            仅原样回环字节，不产生设备 ACK
SERIAL_PORT=sim
# 非动态 BLE 模式下，如库中存在多台登记设备必须显式指定链路对应的设备主键。
# SERIAL_DEVICE_PK=1
# 有线 USB-TTL 波特率（ECB02H2 模块出厂 UART 默认 115200，需与固件 USART3 核对统一）
SERIAL_BAUD=9600

# 低功耗蓝牙模块 ECB02H2 GATT 透传 UUID（不同固件批次可在 .env 覆写，例如 FFE0/FFE1）
BLE_SERVICE_UUID=0000fff0-0000-1000-8000-00805f9b34fb
BLE_NOTIFY_UUID=0000fff1-0000-1000-8000-00805f9b34fb
BLE_WRITE_UUID=0000fff2-0000-1000-8000-00805f9b34fb
# BLE 单次写入切片上限（20~244 字节；20 为 ATT_MTU=23 保守安全值）
BLE_MTU_CHUNK=20
BLE_SCAN_TIMEOUT_SEC=4.0

# JWT 签名密钥。生成方法：python -c "import secrets; print(secrets.token_hex(32))"
# 不要使用任何示例值，示例值等于公开密钥。
JWT_SECRET=

PORT=8000

# 判定离线的静默秒数
ONLINE_TTL_SEC=30

# 开发期临时开关：只在没有开发板时让 /api/devices/heartbeat 注册。
# 接真实心跳时必须连同该路由与 tools/sim_heartbeat.py 一起删除。
DEV_HEARTBEAT=false
